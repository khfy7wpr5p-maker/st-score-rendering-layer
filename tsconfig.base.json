{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "paths": {
      "@st/score-renderer-contracts": ["./packages/contracts/src/index.ts"],
      "@st/score-renderer-core": ["./packages/renderer-core/src/index.ts"],
      "@st/score-renderer-osmd": ["./packages/adapter-osmd/src/index.ts"],
      "@st/score-renderer-osmd-headless": ["./packages/adapter-osmd-headless/src/index.ts"],
      "@st/score-renderer-accessibility": ["./packages/accessibility/src/index.ts"],
      "@st/score-renderer-browser-host": ["./packages/browser-host/src/index.ts"]
    }
  }
}
