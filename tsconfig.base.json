{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": false,
    "baseUrl": ".",
    "paths": {
      "@st/score-renderer-contracts": ["packages/contracts/src/index.ts"],
      "@st/score-renderer-core": ["packages/renderer-core/src/index.ts"]
    }
  }
}
