{
  "name": "st-score-rendering-layer-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["packages/*"],
  "engines": {"node": ">=20.19.0"},
  "scripts": {
    "clean": "tsc -b packages/contracts packages/renderer-core packages/adapter-osmd --clean",
    "build": "tsc -b packages/contracts packages/renderer-core packages/adapter-osmd",
    "typecheck": "tsc -b packages/contracts packages/renderer-core packages/adapter-osmd --pretty false",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
